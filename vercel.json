{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "bank/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/",
      "status": 302,
      "headers": {
        "Location": "/bank/index.html"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
